# Required
DEEPSEEK_API_KEY=

# Model
DEEPSEEK_MODEL=deepseek-v4-flash

# Local user and conversation
OWNER_ID=local-user
DEFAULT_THREAD_ID=main

# Databases
APP_DATABASE_PATH=data/lifepilot.db
CHECKPOINT_DATABASE_PATH=data/checkpoints.db

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/lifepilot.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3

# LangGraph checkpoint security
LANGGRAPH_STRICT_MSGPACK=true