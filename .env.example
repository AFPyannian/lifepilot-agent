# ==============================
# DeepSeek模型
# ==============================

# Required
DEEPSEEK_API_KEY=

DEEPSEEK_MODEL=deepseek-v4-flash

# ==============================
# 本地用户与默认会话
# ==============================

OWNER_ID=local-user
DEFAULT_THREAD_ID=main

# ==============================
# 数据库
# ==============================

APP_DATABASE_PATH=data/lifepilot.db
CHECKPOINT_DATABASE_PATH=data/checkpoints.db

# ==============================
# 日志
# ==============================

LOG_LEVEL=INFO
LOG_FILE_PATH=logs/lifepilot.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3

# ==============================
# LangGraph checkpoint安全配置
# ==============================

LANGGRAPH_STRICT_MSGPACK=true

# ==============================
# 个人知识库
# ==============================

KNOWLEDGE_SOURCE_DIRECTORY=knowledge_base
CHROMA_PERSIST_DIRECTORY=data/chroma

# ==============================
# 本地Embedding模型
# ==============================

# ModelScope下载后的本地模型目录
EMBEDDING_MODEL_NAME=models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ==============================
# RAG切块与检索
# ==============================

KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_RETRIEVAL_K=4
KNOWLEDGE_MAX_FILE_BYTES=20000000