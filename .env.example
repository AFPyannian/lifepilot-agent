# 复制为 .env 后填写本地配置，不要在示例文件中保存真实密钥。

# DeepSeek 模型
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# 账号 Session、登录保护与业务接口限流
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# Agent 单次运行最大图执行步数
AGENT_RECURSION_LIMIT=25

# CLI 本地身份与默认会话（Web/API 使用登录用户身份）
LOCAL_CLI_OWNER_ID=local-user
DEFAULT_THREAD_ID=main

# SQLite 数据库
APP_DATABASE_PATH=data/lifepilot.db
CHECKPOINT_DATABASE_PATH=data/checkpoints.db

# 应用日志
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/lifepilot.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3

# 运行环境与 LangSmith 追踪
APP_ENVIRONMENT=development
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lifepilot-development
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# LangGraph Checkpoint 序列化
LANGGRAPH_STRICT_MSGPACK=true

# 个人知识库路径
KNOWLEDGE_SOURCE_DIRECTORY=knowledge_base
CHROMA_PERSIST_DIRECTORY=data/chroma

# 本地中文 Embedding 模型
EMBEDDING_MODEL_NAME=models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# RAG 切块、检索和文件限制
KNOWLEDGE_CHUNK_SIZE=700
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_RETRIEVAL_K=4
KNOWLEDGE_MAX_FILE_BYTES=20000000

# Streamlit 后端地址
LIFEPILOT_API_URL=http://127.0.0.1:8000
